
import React, { useState } from 'react';

import {
  View,
  Text,
  TextInput,
  Button,
  StyleSheet,
  Alert
} from 'react-native';

export default function App() {

  const [temperatura, setTemperatura] = useState('');
  const [escala, setEscala] = useState('Celsius');
  const [resultado, setResultado] = useState(null);

  function converterTemperatura() {

    // Verificar campo vazio
    if (temperatura.trim() === '') {
      Alert.alert('Atenção', 'Digite uma temperatura!');
      setResultado(null);
      return;
    }

    // Converter texto em número
    const valor = Number(
      temperatura.trim().replace(',', '.')
    );

    // Validar valor numérico
    if (!Number.isFinite(valor)) {
      Alert.alert(
        'Valor inválido',
        'Digite uma temperatura válida.'
      );
      setResultado(null);
      return;
    }

    let convertido;

    // Celsius para Fahrenheit
    if (escala === 'Celsius') {
      convertido = (valor * 9 / 5) + 32;

      setResultado({
        valor: convertido.toFixed(2),
        unidade: '°F',
        origem: '°C'
      });

    } else {

      // Fahrenheit para Celsius
      convertido = (valor - 32) * 5 / 9;

      setResultado({
        valor: convertido.toFixed(2),
        unidade: '°C',
        origem: '°F'
      });
    }
  }

  return (
    <View style={styles.container}>

      <Text style={styles.titulo}>
        Conversor de Temperatura
      </Text>

      <Text style={styles.subtitulo}>
        Converta temperaturas entre Celsius e Fahrenheit.
      </Text>

      <View style={styles.card}>

        <Text style={styles.label}>
          Digite a temperatura:
        </Text>

        <TextInput
          style={styles.input}
          placeholder="Exemplo: 30"
          keyboardType="decimal-pad"
          value={temperatura}
          onChangeText={(valor) => {
            setTemperatura(valor);
            setResultado(null);
          }}
        />

        <Text style={styles.label}>
          Selecione a escala de origem:
        </Text>

        <View style={styles.opcoes}>

          <View style={styles.botaoOpcao}>
            <Button
              title="Celsius (°C)"
              color={escala === 'Celsius' ? '#087E8B' : '#999999'}
              onPress={() => {
                setEscala('Celsius');
                setResultado(null);
              }}
            />
          </View>

          <View style={styles.botaoOpcao}>
            <Button
              title="Fahrenheit (°F)"
              color={escala === 'Fahrenheit' ? '#087E8B' : '#999999'}
              onPress={() => {
                setEscala('Fahrenheit');
                setResultado(null);
              }}
            />
          </View>

        </View>

        <View style={styles.botaoConverter}>
          <Button
            title="Converter"
            color="#075B66"
            onPress={converterTemperatura}
          />
        </View>

        {resultado !== null && (

          <View style={styles.resultado}>

            <Text style={styles.textoResultado}>
              Resultado da conversão:
            </Text>

            <Text style={styles.valor}>
              {resultado.valor.replace('.', ',')} {resultado.unidade}
            </Text>

            <Text style={styles.detalhe}>
              Escala de origem: {resultado.origem}
            </Text>

          </View>

        )}

      </View>

      <Text style={styles.rodape}>
        Conversão entre Celsius e Fahrenheit.
      </Text>

    </View>
  );
}

